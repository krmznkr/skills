diff --git a/src/middleware/rate-limit.ts b/src/middleware/rate-limit.ts
new file mode 100644
index 0000000..e9937b7
--- /dev/null
+++ b/src/middleware/rate-limit.ts
@@ -0,0 +1,37 @@
+import { Request, Response, NextFunction } from "express"
+
+interface Bucket {
+  tokens: number
+  updated: number
+}
+
+export class RateLimiter {
+  private buckets = new Map<string, Bucket>()
+
+  constructor(private capacity = 60, private refillPerSec = 1) {}
+
+  private take(key: string): boolean {
+    const now = Date.now() / 1000
+    const b = this.buckets.get(key) ?? { tokens: this.capacity, updated: now }
+    b.tokens = Math.min(this.capacity, b.tokens + (now - b.updated) * this.refillPerSec)
+    b.updated = now
+    if (b.tokens < 1) {
+      this.buckets.set(key, b)
+      return false
+    }
+    b.tokens -= 1
+    this.buckets.set(key, b)
+    return true
+  }
+
+  middleware() {
+    return (req: Request, res: Response, next: NextFunction) => {
+      const key = req.ip ?? "anon"
+      if (!this.take(key)) {
+        res.setHeader("Retry-After", "1")
+        return res.status(429).json({ error: "rate_limited" })
+      }
+      next()
+    }
+  }
+}
